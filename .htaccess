RewriteEngine On

# 1. Redirect legacy /admin or /ADMIN to ipessadmin/
RewriteCond %{REQUEST_URI} ^(?:/IPESS)?/(?:ADMIN|admin)/?$ [NC]
RewriteRule ^(?:ADMIN|admin)/?$ ipessadmin/ [L,R=301]

RewriteCond %{REQUEST_URI} ^(?:/IPESS)?/(?:ADMIN|admin)/(.*)$ [NC]
RewriteRule ^(?:ADMIN|admin)/(.*)$ ipessadmin/$1 [L,R=301]

# 2. Prevent directory listing issues and ensure standard index handling
Options -Indexes
DirectoryIndex index.php index.html
